# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Leave empty or set to mongodb://localhost:27017/grant_assistant)
# If local MongoDB is not running, server automatically boots an in-memory MongoDB instance for seamless dev/testing
MONGODB_URI=mongodb://127.0.0.1:27017/grant_completeness_assistant

# AI Provider Selection: 'mock' | 'ollama' | 'gemini'
AI_PROVIDER=mock

# Ollama Configuration (For local AI execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini Configuration (For production AI execution)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Authentication (Demo credentials)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123
JWT_SECRET=supersecret_demo_jwt_key_grant_check_2026

# Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173
